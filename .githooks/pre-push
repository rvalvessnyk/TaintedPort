#!/bin/sh
# Block pushes that would leak vuln answer-key content into the PUBLIC repo.
# Scans the commits being pushed (history-aware) plus the current tracked tree.
# See tests/check_no_vuln_leak.py.
ROOT=$(git rev-parse --show-toplevel)
SCAN="$ROOT/tests/check_no_vuln_leak.py"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # skip branch deletions (local oid is all zeros)
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    python3 "$SCAN" --range "$remote_oid" "$local_oid" || status=1
done

# safety net: also scan the current tracked working tree
python3 "$SCAN" || status=1

[ "$status" -ne 0 ] && echo "pre-push: vuln-leak guard failed — push aborted." >&2
exit "$status"
